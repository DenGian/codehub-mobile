{
  "expo": {
    "name": "CodeHub",
    "slug": "codehub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "codehub-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
